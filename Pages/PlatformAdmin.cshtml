@page
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "PlatformAdmin")]
@{
    ViewData["Title"] = "مدیریت کل سامانه";
}
<div class="container py-4" dir="rtl" style="max-width:1100px">
    <section class="p-4 p-md-5 mb-4 rounded-4 border" style="background:linear-gradient(120deg,#f7fbff,#e8f2ff);border-color:#d9e7f7!important">
        <span class="text-primary fw-bold small">GHOGHNOOS · PLATFORM ADMIN</span>
        <h1 class="mt-2 mb-3">مدیریت کل سامانه ققنوس</h1>
        <p class="text-secondary mb-0" style="line-height:2">
            ورود شما به‌عنوان مدیر کل سامانه تأیید شده است. این حساب برای ورود به پنل مدیریتی به عضویت هیچ شرکت یا فضای کاری نیاز ندارد.
        </p>
    </section>
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100"><div class="card-body p-4">
                <h2 class="h5">حساب مدیر کل</h2>
                <p class="text-secondary mb-2">ghoghnoos.office@gmail.com</p>
                <span class="badge text-bg-success">ورود مستقل از شرکت</span>
            </div></div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100"><div class="card-body p-4">
                <h2 class="h5">مرز دسترسی‌ها</h2>
                <p class="text-secondary mb-0" style="line-height:1.9">
                    پنل مدیر کل از عضویت شرکت جداست. دسترسی به اسناد مالی هر شرکت همچنان به انتخاب فضای کاری و مجوزهای معتبر همان شرکت وابسته است.
                </p>
            </div></div>
        </div>
    </div>
    <section class="card border-0 shadow-sm mt-3"><div class="card-body p-4">
        <h2 class="h5">مدیریت شرکت‌ها و کاربران</h2>
        <p class="text-secondary" style="line-height:1.9">شرکت جدید بسازید، کاربران و مدیران شرکت‌ها را تعریف کنید و عضویت‌ها را مدیریت کنید.</p>
        <a class="btn btn-primary mb-3" asp-page="/PlatformAdmin/Management">ورود به مدیریت شرکت‌ها و کاربران</a>
        <h2 class="h5">مرحله بعدی مدیریت</h2>
        <p class="text-secondary" style="line-height:1.9">
            این صفحه نقطه ورود مستقل مدیر کل است. مدیریت شرکت‌ها، فعال‌سازی کاربران و تعیین مدیر هر شرکت باید از ابزارهای مدیریتی مخصوص همین پنل انجام شود؛ این تغییر به‌تنهایی عضویت یا شرکت ساختگی برای حساب ایجاد نمی‌کند.
        </p>
        <form method="post" asp-page="/Account/Logout">
            <button type="submit" class="btn btn-outline-secondary">خروج از حساب</button>
        </form>
    </div></section>
</div>
