@page
@{
    ViewData["Title"] = "گردش حساب مشتری";
}
<div class="statement-page" dir="rtl">
    <section class="statement-hero">
        <div>
            <a class="back-link" href="/Accounting/Parties">← بازگشت به اشخاص</a>
            <span class="eyebrow">گزارش تفصیلی طرف حساب</span>
            <h1 id="partyTitle">گردش حساب</h1>
            <p id="partySubtitle">فاکتورهای ثبت‌نهایی‌شده و اسناد دریافت و پرداخت به ترتیب تاریخ.</p>
        </div>
        <div class="hero-icon" aria-hidden="true">↔</div>
    </section>

    <section class="balance-card">
        <div class="balance-label"><span class="balance-dot"></span><span>مانده کل حساب</span></div>
        <div class="balance-main"><strong id="overallBalance">—</strong><span id="overallSide" class="balance-side">در حال محاسبه</span></div>
        <div class="balance-caption">مانده کل بر اساس تمام اسناد ثبت‌نهایی‌شده، مستقل از فیلتر تاریخ</div>
    </section>

    <section class="panel">
        <div class="section-heading"><div><h2>فیلتر گردش حساب</h2><p>برای مشاهده یک بازه مشخص، تاریخ شروع و پایان را انتخاب کنید.</p></div></div>
        <div class="filters">
            <label>از تاریخ<input id="fromDate" type="date"></label>
            <label>تا تاریخ<input id="toDate" type="date"></label>
            <div class="filter-actions"><button id="applyFilter" type="button">اعمال فیلتر</button><button id="clearFilter" type="button" class="secondary">کل دوره</button></div>
        </div>
        <p id="message" role="status" aria-live="polite"></p>
        <div class="summary-grid">
            <div class="summary-item"><span>مانده ابتدای بازه</span><strong id="openingBalance">—</strong></div>
            <div class="summary-item debit"><span>جمع بدهکار بازه</span><strong id="periodDebit">۰</strong></div>
            <div class="summary-item credit"><span>جمع بستانکار بازه</span><strong id="periodCredit">۰</strong></div>
            <div class="summary-item"><span>مانده پایان بازه</span><strong id="closingBalance">—</strong></div>
        </div>
        <div class="table-scroll">
            <table>
                <thead><tr><th>تاریخ</th><th>نوع سند</th><th>شرح</th><th>بدهکار (ریال)</th><th>بستانکار (ریال)</th><th>مانده پس از سند</th><th>مشاهده</th></tr></thead>
                <tbody id="statementRows"><tr><td colspan="7">در حال دریافت اطلاعات…</td></tr></tbody>
            </table>
        </div>
        <p id="rowCount" class="row-count"></p>
    </section>
</div>

<div id="documentModal" class="document-modal" hidden role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal-backdrop" data-close-modal="true"></div>
    <section class="modal-panel">
        <header class="modal-header"><div><span class="eyebrow">نمایش سند</span><h2 id="modalTitle">جزئیات سند</h2></div><button id="closeModal" type="button" class="modal-close" aria-label="بستن">×</button></header>
        <div id="modalBody" class="modal-body"><p>در حال دریافت جزئیات سند…</p></div>
        <footer class="modal-footer"><button id="modalCloseBottom" type="button" class="secondary">بستن پنجره</button></footer>
    </section>
</div>

<style>
.statement-page{max-width:1450px;margin:auto;color:#20334b;font-family:Tahoma,Arial,sans-serif}.statement-hero{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:25px 29px;margin-bottom:16px;border:1px solid #dbe9f8;border-radius:17px;background:linear-gradient(115deg,#fff,#eaf4ff)}.back-link{display:inline-block;margin-bottom:14px;color:#3977b6;text-decoration:none;font-size:11px}.back-link:hover{text-decoration:underline}.eyebrow{display:block;font-size:11px;color:#2677c9;font-weight:700}.statement-hero h1{font-size:25px;margin:8px 0}.statement-hero p{margin:0;color:#74859a;font-size:12px;line-height:1.9}.hero-icon{display:grid;place-items:center;flex:0 0 64px;width:64px;height:64px;border-radius:19px;background:#d8eaff;color:#2677c9;font-size:34px}.balance-card{padding:22px 25px;margin-bottom:17px;border-radius:15px;background:linear-gradient(120deg,#153e66,#2677c9);color:#fff;box-shadow:0 10px 25px #2677c91a}.balance-label{display:flex;align-items:center;gap:8px;font-size:12px;color:#e0edfb}.balance-dot{width:8px;height:8px;border-radius:50%;background:#7de0b3}.balance-main{display:flex;align-items:center;gap:13px;flex-wrap:wrap;margin-top:10px}.balance-main strong{font-size:27px;font-weight:800;letter-spacing:.2px}.balance-side{padding:5px 10px;border:1px solid #ffffff50;border-radius:999px;font-size:11px}.balance-caption{margin-top:9px;color:#d3e4f6;font-size:11px}.panel{padding:21px;margin-bottom:18px;background:#fff;border:1px solid #e2eaf4;border-radius:15px;min-width:0}.section-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}.section-heading h2{font-size:16px;margin:0 0 6px}.section-heading p{font-size:11px;color:#8292a6;margin:0}.filters{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;align-items:end}.filters label{display:flex;flex-direction:column;gap:7px;font-size:12px;font-weight:700;color:#52667e}.statement-page input{box-sizing:border-box;width:100%;min-width:0;padding:11px;border:1px solid #d9e3ef;border-radius:9px;background:#fff;color:#20334b;font:inherit;font-size:12px;outline:none}.statement-page input:focus{border-color:#70a9e5;box-shadow:0 0 0 3px #2677c915}.filter-actions{display:flex;gap:8px}.statement-page button{border:0;border-radius:9px;padding:11px 15px;background:#2677c9;color:white;font:inherit;font-size:12px;cursor:pointer;transition:background .15s,transform .15s}.statement-page button:hover{background:#1f68b1}.statement-page button:active{transform:translateY(1px)}.statement-page button.secondary,.modal-footer button.secondary{background:#edf5ff;color:#2465a5}.statement-page button.secondary:hover,.modal-footer button.secondary:hover{background:#dcecff}#message{margin:12px 0 0;font-size:11px;line-height:1.8;color:#60758d;white-space:pre-wrap}.summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:17px}.summary-item{min-width:0;padding:13px;border:1px solid #e5edf6;border-radius:11px;background:#f8fbff}.summary-item span,.summary-item strong{display:block}.summary-item span{font-size:11px;color:#8292a6}.summary-item strong{margin-top:9px;font-size:15px;overflow-wrap:anywhere}.summary-item.debit{background:#fff8f5;border-color:#f7e5dc}.summary-item.debit strong{color:#b45336}.summary-item.credit{background:#f1fbf7;border-color:#d8f1e5}.summary-item.credit strong{color:#16865e}.table-scroll{overflow:auto;margin-top:18px;border:1px solid #edf1f6;border-radius:10px}table{width:100%;border-collapse:collapse;min-width:900px}th,td{padding:12px 10px;text-align:right;border-bottom:1px solid #edf1f6;font-size:11px;line-height:1.8;vertical-align:middle}th{background:#f7faff;color:#64768b;font-weight:700;white-space:nowrap}td{color:#435970}tbody tr:hover{background:#fbfdff}tbody tr:last-child td{border-bottom:0}.money-cell{white-space:nowrap;font-variant-numeric:tabular-nums}.debit-value{color:#b45336}.credit-value{color:#16865e}.balance-value{font-weight:700;white-space:nowrap}.document-kind{display:inline-block;padding:5px 8px;border-radius:7px;background:#edf5ff;color:#2b6ca9;white-space:nowrap}.document-kind.receipt{background:#e9f8f1;color:#16865e}.document-kind.payment{background:#fff2e8;color:#b65d24}.document-kind.purchase{background:#f1ecff;color:#6d4bb5}.view-document{padding:7px 10px!important;background:#edf5ff!important;color:#2465a5!important;white-space:nowrap}.view-document:hover{background:#dcecff!important}.row-count{text-align:left;color:#8292a6;font-size:11px;margin:10px 2px 0}.document-modal[hidden]{display:none}.document-modal{position:fixed;inset:0;z-index:3000;display:grid;place-items:center;padding:18px}.modal-backdrop{position:absolute;inset:0;background:#0e233b80;backdrop-filter:blur(4px)}.modal-panel{position:relative;z-index:1;width:min(850px,100%);max-height:min(88vh,900px);display:flex;flex-direction:column;overflow:hidden;border:1px solid #dce7f3;border-radius:18px;background:#fff;box-shadow:0 25px 80px #0b25444a;animation:modalIn .18s ease-out}.modal-header{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:19px 22px;border-bottom:1px solid #e8eef5;background:linear-gradient(110deg,#fff,#f1f7ff)}.modal-header h2{font-size:18px;margin:7px 0 0;color:#20334b}.modal-close{display:grid;place-items:center;width:36px;height:36px;padding:0!important;border-radius:10px!important;background:#edf5ff!important;color:#315c84!important;font-size:26px!important}.modal-body{padding:20px 22px;overflow:auto;min-height:100px}.modal-footer{padding:13px 22px;border-top:1px solid #e8eef5;display:flex;justify-content:flex-start;background:#fbfdff}.modal-footer button{border:0;border-radius:9px;padding:10px 15px;font:inherit;font-size:12px;cursor:pointer}.doc-meta{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:15px}.doc-meta-item{padding:12px;border:1px solid #e4edf6;border-radius:10px;background:#f8fbff;min-width:0}.doc-meta-item span,.doc-meta-item strong{display:block}.doc-meta-item span{font-size:10px;color:#8292a6;margin-bottom:7px}.doc-meta-item strong{font-size:12px;color:#294560;overflow-wrap:anywhere}.doc-notes{padding:12px;margin-top:14px;border:1px dashed #d4dfeb;border-radius:10px;background:#fbfdff;font-size:12px;line-height:1.9;white-space:pre-wrap}.doc-table-wrap{overflow:auto;border:1px solid #e8eef5;border-radius:10px}.doc-table{width:100%;min-width:580px;border-collapse:collapse}.doc-table th,.doc-table td{padding:10px;border-bottom:1px solid #edf1f6;text-align:right;font-size:11px}.doc-total{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:14px;padding:15px;border-radius:11px;background:#edf5ff;color:#244d75;font-size:12px}.doc-total strong{font-size:16px}@@keyframes modalIn{from{opacity:0;transform:translateY(8px) scale(.99)}to{opacity:1;transform:translateY(0) scale(1)}}@@media(max-width:850px){.summary-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.filters{grid-template-columns:1fr 1fr}.filter-actions{grid-column:1/-1}.statement-hero{padding:21px}.panel{padding:15px}}@@media(max-width:560px){.statement-hero h1{font-size:21px}.hero-icon{width:48px;height:48px;flex-basis:48px;font-size:27px;border-radius:14px}.balance-card{padding:19px}.balance-main strong{font-size:23px}.filters{grid-template-columns:1fr}.filter-actions{grid-column:auto}.filter-actions button{flex:1}.doc-meta{grid-template-columns:1fr 1fr}.modal-header,.modal-body{padding:15px}.modal-panel{max-height:92vh}.summary-item{padding:11px}.summary-item strong{font-size:13px}}
</style>

<script>
(() => {
    const $ = id => document.getElementById(id);
    const params = new URLSearchParams(window.location.search);
    const partyId = Number(params.get('partyId'));
    let lastFocused = null;
    const money = value => Math.abs(Number(value || 0)).toLocaleString('fa-IR', { maximumFractionDigits: 2 });
    const signedBalance = value => {
        const n = Number(value || 0);
        if (Math.abs(n) < 0.005) return '۰ ریال · تسویه';
        return money(n) + ' ریال · ' + (n > 0 ? 'بدهکار' : 'بستانکار');
    };
    const dateText = value => value ? new Date(value).toLocaleDateString('fa-IR') : '—';
    async function jsonResponse(response) {
        const text = await response.text();
        let data = {};
        try { data = text ? JSON.parse(text) : {}; } catch { data = {}; }
        if (!response.ok) throw new Error(data.message || data.detail || 'دریافت اطلاعات ناموفق بود.');
        return data;
    }
    function el(tag, className, text) {
        const node = document.createElement(tag);
        if (className) node.className = className;
        if (text !== undefined && text !== null) node.textContent = String(text);
        return node;
    }
    function metaItem(label, value) {
        const box = el('div', 'doc-meta-item');
        box.append(el('span', '', label), el('strong', '', value || '—'));
        return box;
    }
    function setBalance(id, value) { $(id).textContent = signedBalance(value); }
    function kindLabel(kind) {
        return ({ SalesInvoice: 'فاکتور فروش', PurchaseInvoice: 'فاکتور خرید', Receipt: 'دریافتی', Payment: 'پرداختی' })[kind] || kind || 'سند';
    }
    function kindClass(kind) {
        return ({ SalesInvoice: 'sales', PurchaseInvoice: 'purchase', Receipt: 'receipt', Payment: 'payment' })[kind] || '';
    }
    async function loadStatement() {
        if (!Number.isInteger(partyId) || partyId <= 0) {
            $('message').textContent = 'شناسه طرف حساب معتبر نیست. از فهرست اشخاص وارد گردش حساب شوید.';
            $('statementRows').replaceChildren();
            return;
        }
        $('message').textContent = 'در حال دریافت گردش حساب…';
        $('statementRows').replaceChildren(el('tr'));
        const query = new URLSearchParams();
        if ($('fromDate').value) query.set('from', $('fromDate').value);
        if ($('toDate').value) query.set('to', $('toDate').value);
        try {
            const data = await jsonResponse(await fetch('/api/accounting/parties/' + partyId + '/statement' + (query.size ? '?' + query.toString() : '')));
            $('partyTitle').textContent = 'گردش حساب · ' + data.party.name;
            $('partySubtitle').textContent = [data.party.phone, data.party.address].filter(Boolean).join(' · ') || 'فاکتورهای ثبت‌نهایی‌شده و اسناد دریافت و پرداخت به ترتیب تاریخ.';
            $('overallBalance').textContent = money(data.overallBalance) + ' ریال';
            $('overallSide').textContent = data.overallBalance > 0 ? 'بدهکار' : data.overallBalance < 0 ? 'بستانکار' : 'تسویه';
            $('overallSide').style.background = data.overallBalance > 0 ? '#b4533622' : data.overallBalance < 0 ? '#7de0b322' : '#ffffff20';
            setBalance('openingBalance', data.openingBalance);
            $('periodDebit').textContent = money(data.periodDebit) + ' ریال';
            $('periodCredit').textContent = money(data.periodCredit) + ' ریال';
            setBalance('closingBalance', data.closingBalance);
            const body = $('statementRows');
            body.replaceChildren();
            for (const row of data.transactions) {
                const tr = document.createElement('tr');
                tr.className = 'statement-' + kindClass(row.kind);
                tr.append(el('td', '', dateText(row.date)));
                const kind = el('td');
                kind.append(el('span', 'document-kind ' + kindClass(row.kind), kindLabel(row.kind)));
                tr.append(kind, el('td', '', row.description || kindLabel(row.kind)));
                tr.append(el('td', 'money-cell debit-value', row.debit ? money(row.debit) : '—'));
                tr.append(el('td', 'money-cell credit-value', row.credit ? money(row.credit) : '—'));
                tr.append(el('td', 'balance-value', signedBalance(row.balance)));
                const actionCell = el('td');
                const open = el('button', 'view-document', 'مشاهده سند');
                open.type = 'button';
                open.addEventListener('click', () => openDocument(row, data.party.name));
                actionCell.append(open); tr.append(actionCell); body.append(tr);
            }
            if (!data.transactions.length) {
                const tr = el('tr'), td = el('td', '', 'در این بازه سند ثبت‌نهایی‌شده‌ای برای این طرف حساب وجود ندارد.');
                td.colSpan = 7; tr.append(td); body.append(tr);
            }
            $('rowCount').textContent = data.transactions.length.toLocaleString('fa-IR') + ' سند در این بازه';
            $('message').textContent = 'گردش حساب با موفقیت به‌روزرسانی شد.';
        } catch (error) {
            $('message').textContent = error.message || 'خطا در دریافت گردش حساب.';
            const body = $('statementRows'); body.replaceChildren();
            const tr = el('tr'), td = el('td', '', 'اطلاعات گردش حساب دریافت نشد.'); td.colSpan = 7; tr.append(td); body.append(tr);
        }
    }
    function openModal(title) {
        lastFocused = document.activeElement;
        $('modalTitle').textContent = title;
        $('modalBody').replaceChildren(el('p', '', 'در حال دریافت جزئیات سند…'));
        $('documentModal').hidden = false;
        document.body.style.overflow = 'hidden';
        $('closeModal').focus();
    }
    function closeModal() {
        $('documentModal').hidden = true;
        document.body.style.overflow = '';
        if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
    }
    function docTable(headers, rows) {
        const wrap = el('div', 'doc-table-wrap'), table = el('table', 'doc-table');
        const thead = el('thead'), headRow = el('tr');
        headers.forEach(x => headRow.append(el('th', '', x)));
        thead.append(headRow); table.append(thead);
        const tbody = el('tbody');
        rows.forEach(values => {
            const tr = el('tr');
            values.forEach(value => tr.append(el('td', '', value)));
            tbody.append(tr);
        });
        table.append(tbody); wrap.append(table); return wrap;
    }
    async function openDocument(row, partyName) {
        const sourceType = row.sourceType || (String(row.kind || '').includes('Invoice') ? 'Invoice' : 'Payment');
        const isInvoice = sourceType === 'Invoice';
        const sourceId = Number(row.sourceId);
        openModal(kindLabel(row.kind) + ' شماره ' + (row.number || '—'));
        const body = $('modalBody');
        body.style.color = '#20334b';
        body.style.display = 'block';
        try {
            if (!Number.isInteger(sourceId) || sourceId <= 0) {
                throw new Error('شناسه سند در اطلاعات گردش حساب موجود نیست. صفحه را بازخوانی کنید.');
            }
            const url = (isInvoice ? '/api/accounting/invoices/' : '/api/accounting/payments/') + encodeURIComponent(sourceId);
            const data = await jsonResponse(await fetch(url, { headers: { 'Accept': 'application/json' } }));
            body.replaceChildren();
            if (isInvoice) {
                const invoiceKind = data.kind === 'Sales' ? 'فروش' : 'خرید';
                const meta = el('div', 'doc-meta');
                meta.append(metaItem('طرف حساب', partyName), metaItem('شماره فاکتور', data.number), metaItem('تاریخ', dateText(data.invoiceDate)), metaItem('نوع', 'فاکتور ' + invoiceKind), metaItem('وضعیت', data.status === 'Posted' ? 'ثبت نهایی‌شده' : 'پیش‌نویس'), metaItem('جمع نهایی', money(data.total) + ' ریال'));
                body.append(meta);
                const lines = (Array.isArray(data.lines) ? data.lines : []).map((line, index) => {
                    const gross = Math.round(Number(line.quantity || 0) * Number(line.unitPrice || 0) * 100) / 100;
                    const subtotal = gross - Number(line.discount || 0);
                    const tax = Math.round(subtotal * Number(line.taxRate || 0)) / 100;
                    return [index + 1, line.description || '—', money(line.quantity), money(line.unitPrice), money(line.discount), money(line.taxRate) + '٪', money(subtotal + tax)];
                });
                body.append(docTable(['ردیف', 'شرح', 'تعداد', 'قیمت واحد', 'تخفیف', 'مالیات', 'مبلغ نهایی'], lines));
                const total = el('div', 'doc-total'); total.append(el('span', '', 'مبلغ نهایی فاکتور'), el('strong', '', money(data.total) + ' ریال')); body.append(total);
                if (data.notes) body.append(el('div', 'doc-notes', 'توضیحات: ' + data.notes));
                if (!lines.length) body.append(el('p', '', 'برای این فاکتور ردیف کالایی ثبت نشده است.'));
            } else {
                const meta = el('div', 'doc-meta');
                meta.append(metaItem('طرف حساب', data.partyName || partyName), metaItem('شماره سند دریافت/پرداخت', data.number), metaItem('تاریخ', dateText(data.paymentDate)), metaItem('نوع عملیات', data.kind === 'Receipt' ? 'دریافت از مشتری' : 'پرداخت به تأمین‌کننده'), metaItem('حساب صندوق / بانک', data.cashAccountTitle), metaItem('فاکتور مرتبط', data.invoiceNumber || '—'), metaItem('سند حسابداری', data.journalEntryNumber || '—'));
                body.append(meta);
                const total = el('div', 'doc-total'); total.append(el('span', '', data.kind === 'Receipt' ? 'مبلغ دریافتی' : 'مبلغ پرداختی'), el('strong', '', money(data.amount) + ' ریال')); body.append(total);
                if (data.notes) body.append(el('div', 'doc-notes', 'شرح: ' + data.notes));
            }
            if (!body.childElementCount) body.append(el('p', '', 'جزئیات این سند خالی است.'));
        } catch (error) {
            body.replaceChildren(el('p', '', 'نمایش جزئیات سند ناموفق بود: ' + (error.message || 'خطای نامشخص')));
        }
    }
    $('applyFilter').addEventListener('click', loadStatement);
    $('clearFilter').addEventListener('click', () => { $('fromDate').value = ''; $('toDate').value = ''; loadStatement(); });
    $('closeModal').addEventListener('click', closeModal);
    $('modalCloseBottom').addEventListener('click', closeModal);
    $('documentModal').addEventListener('click', event => { if (event.target.dataset.closeModal === 'true') closeModal(); });
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && !$('documentModal').hidden) closeModal(); });
    loadStatement();
})();
</script>