@page
@{
    ViewData["Title"] = "عملیات مالی";
}
<div class="business-page" dir="rtl">
  <section class="hero">
    <div><span class="eyebrow">امور روزمره حسابداری</span><h1>عملیات مالی</h1><p>چهار عملیات اصلی را جداگانه انتخاب کنید. ثبت فاکتور و تسویه وجه دو مرحله مستقل هستند.</p></div>
  </section>
  <section class="operation-grid">
    <a class="operation-card" href="/Accounting/Invoices?kind=Sales"><span class="operation-icon">↗</span><strong>فاکتور فروش</strong><small>ثبت فروش و ایجاد طلب از مشتری</small></a>
    <a class="operation-card" href="/Accounting/Invoices?kind=Purchase"><span class="operation-icon">↙</span><strong>فاکتور خرید</strong><small>ثبت خرید و ایجاد بدهی به فروشنده</small></a>
    <a class="operation-card" href="/Accounting/Payments?kind=Receipt"><span class="operation-icon">＋</span><strong>سند دریافت وجه</strong><small>ثبت وجه دریافتی و کاهش مانده مشتری</small></a>
    <a class="operation-card" href="/Accounting/Payments?kind=Payment"><span class="operation-icon">−</span><strong>سند پرداخت وجه</strong><small>ثبت وجه پرداختی و کاهش بدهی فروشنده</small></a>
  </section>
</div>
<style>
.business-page{max-width:1200px;margin:auto;color:#20334b;font-family:Tahoma,Arial,sans-serif}.hero{padding:24px 28px;margin-bottom:20px;border:1px solid #dbe9f8;border-radius:17px;background:linear-gradient(110deg,#fff,#eaf4ff)}.eyebrow{font-size:11px;color:#2677c9;font-weight:700}.hero h1{font-size:25px;margin:9px 0}.hero p{margin:0;color:#74859a;font-size:12px;line-height:1.9}.operation-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.operation-card{display:grid;grid-template-columns:56px 1fr;grid-template-rows:auto auto;column-gap:15px;align-items:center;padding:22px;background:#fff;border:1px solid #e2eaf4;border-radius:15px;text-decoration:none;color:#20334b;transition:transform .15s,border-color .15s}.operation-card:hover{transform:translateY(-2px);border-color:#9fc8f2;color:#20334b}.operation-icon{grid-row:span 2;display:grid;place-items:center;width:56px;height:56px;border-radius:14px;background:#eaf4ff;color:#2677c9;font-size:27px}.operation-card strong{font-size:16px}.operation-card small{margin-top:7px;color:#74859a;font-size:12px;line-height:1.8}@media(max-width:650px){.operation-grid{grid-template-columns:1fr}.hero{padding:20px}}
</style>