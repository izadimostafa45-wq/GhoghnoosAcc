@page
@{
    ViewData["Title"] = "مدیریت حساب‌ها";
}
<div dir="rtl" style="max-width:900px;margin:24px auto;padding:20px;font-family:Tahoma,Arial,sans-serif">
    <h1>مدیریت حساب‌ها</h1>
    <p>برای ثبت سند حسابداری، ابتدا حساب‌های موردنیاز را با کد و عنوان یکتا تعریف کنید.</p>
    <form id="accountForm" style="display:flex;gap:10px;flex-wrap:wrap;margin:20px 0">
        <input id="code" required maxlength="30" placeholder="کد حساب" style="padding:10px;flex:1;min-width:120px" />
        <input id="title" required maxlength="200" placeholder="عنوان حساب" style="padding:10px;flex:2;min-width:180px" />
        <select id="type" style="padding:10px">
            <option value="General">عمومی</option>
            <option value="Asset">دارایی</option>
            <option value="Liability">بدهی</option>
            <option value="Equity">حقوق مالکانه</option>
            <option value="Revenue">درآمد</option>
            <option value="Expense">هزینه</option>
        </select>
        <button type="submit" style="padding:10px 18px;cursor:pointer">ثبت حساب</button>
    </form>
    <p id="message" role="status" style="white-space:pre-wrap"></p>
    <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse">
            <thead><tr><th style="text-align:right;padding:10px;border-bottom:1px solid #ddd">کد</th><th style="text-align:right;padding:10px;border-bottom:1px solid #ddd">عنوان</th><th style="text-align:right;padding:10px;border-bottom:1px solid #ddd">نوع</th><th style="text-align:right;padding:10px;border-bottom:1px solid #ddd">وضعیت</th></tr></thead>
            <tbody id="accounts"></tbody>
        </table>
    </div>
</div>
<script>
(() => {
    const form = document.getElementById('accountForm');
    const message = document.getElementById('message');
    const body = document.getElementById('accounts');
    async function loadAccounts() {
        const response = await fetch('/api/accounting/accounts');
        const data = await response.json();
        if (!response.ok) throw new Error(data.detail || data.message || 'بارگذاری حساب‌ها ناموفق بود.');
        body.replaceChildren();
        for (const account of data) {
            const row = document.createElement('tr');
            for (const value of [account.code, account.title, account.type, account.isActive ? 'فعال' : 'غیرفعال']) {
                const cell = document.createElement('td');
                cell.textContent = value;
                cell.style.padding = '10px';
                cell.style.borderBottom = '1px solid #eee';
                row.appendChild(cell);
            }
            body.appendChild(row);
        }
    }
    form.addEventListener('submit', async event => {
        event.preventDefault();
        message.textContent = 'در حال ثبت حساب...';
        try {
            const response = await fetch('/api/accounting/accounts', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    code: document.getElementById('code').value.trim(),
                    title: document.getElementById('title').value.trim(),
                    type: document.getElementById('type').value
                })
            });
            const data = await response.json();
            if (!response.ok) throw new Error(data.detail || data.message || 'ثبت حساب ناموفق بود.');
            form.reset();
            message.textContent = 'حساب با موفقیت در پایگاه داده ثبت شد.';
            await loadAccounts();
        } catch (error) {
            message.textContent = error.message || 'ارتباط با سرور برقرار نشد.';
        }
    });
    loadAccounts().catch(error => { message.textContent = error.message || 'بارگذاری حساب‌ها ناموفق بود.'; });
})();
</script>
