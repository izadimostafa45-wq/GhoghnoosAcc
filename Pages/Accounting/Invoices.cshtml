@page
@{
    ViewData["Title"] = "فروش و خرید";
}
<div class="business-page" dir="rtl">
    <section class="hero"><div><span class="eyebrow">عملیات بازرگانی</span><h1>فاکتورهای فروش و خرید</h1><p>ثبت فاکتور، محاسبه ردیف‌ها و مالیات، و ایجاد سند حسابداری از فاکتور تأییدشده.</p></div></section>
    <section class="panel">
        <div class="form-grid">
            <label>نوع فاکتور<select id="kind"><option value="Sales">فروش</option><option value="Purchase">خرید</option></select></label>
            <label>شماره فاکتور<input id="number" maxlength="40" required placeholder="مثلاً S-1001"></label>
            <label>تاریخ<input id="invoiceDate" type="date" required></label>
            <label>مشتری / تأمین‌کننده<select id="party" required><option value="">در حال بارگذاری...</option></select></label>
        </div>
        <label class="notes-label">توضیحات<input id="notes" maxlength="500" placeholder="توضیحات اختیاری"></label>
        <div class="table-scroll"><table><thead><tr><th>شرح کالا یا خدمت</th><th>تعداد</th><th>قیمت واحد (ریال)</th><th>تخفیف (ریال)</th><th>مالیات ٪</th><th>مبلغ کل</th><th></th></tr></thead><tbody id="lines"></tbody></table></div>
        <div class="actions"><button type="button" id="addLine" class="secondary">افزودن ردیف</button><button type="button" id="saveDraft">ذخیره پیش‌نویس</button></div>
        <div class="totals"><div><span>جمع جزء</span><strong id="subtotal">۰</strong></div><div><span>مالیات</span><strong id="tax">۰</strong></div><div><span>مبلغ نهایی</span><strong id="total">۰</strong></div></div>
        <p id="message" role="status" aria-live="polite"></p>
    </section>
    <section class="panel"><div class="list-head"><h2>فاکتورهای ثبت‌شده</h2><button type="button" class="secondary" id="refresh">بازخوانی</button></div><div class="table-scroll"><table><thead><tr><th>شماره</th><th>نوع</th><th>تاریخ</th><th>طرف حساب</th><th>مبلغ فاکتور</th><th>دریافتی / پرداختی</th><th>مانده</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody id="invoiceRows"><tr><td colspan="9">در حال دریافت...</td></tr></tbody></table></div></section>
</div>
<style>
.business-page{max-width:1400px;margin:auto;color:#20334b;font-family:Tahoma,Arial,sans-serif}.hero{padding:24px 28px;margin-bottom:18px;border:1px solid #dbe9f8;border-radius:17px;background:linear-gradient(110deg,#fff,#eaf4ff)}.eyebrow{font-size:11px;color:#2677c9;font-weight:700}.hero h1{font-size:25px;margin:9px 0}.hero p{margin:0;color:#74859a;font-size:12px;line-height:1.9}.panel{padding:20px;margin-bottom:18px;background:#fff;border:1px solid #e2eaf4;border-radius:15px}.form-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.form-grid label,.notes-label{display:flex;flex-direction:column;gap:7px;font-size:12px;color:#52667e;font-weight:700}.business-page input,.business-page select{min-width:0;padding:10px;border:1px solid #d9e3ef;border-radius:8px;background:#fff;font:inherit;font-size:12px}.notes-label{margin-top:14px}.table-scroll{overflow:auto;margin-top:16px}table{width:100%;border-collapse:collapse;min-width:780px}th,td{padding:11px 9px;text-align:right;border-bottom:1px solid #edf1f6;font-size:12px}th{background:#f7faff;color:#64768b}td input{width:100%;box-sizing:border-box}.actions,.list-head{display:flex;align-items:center;gap:10px;justify-content:space-between;margin-top:14px}.business-page button{border:0;border-radius:8px;padding:10px 15px;background:#2677c9;color:white;font:inherit;font-size:12px;cursor:pointer}.business-page button.secondary{background:#edf5ff;color:#2465a5}.totals{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:18px}.totals div{padding:13px;border:1px solid #e5edf6;border-radius:10px;background:#f8fbff}.totals span,.totals strong{display:block}.totals span{font-size:11px;color:#8292a6}.totals strong{margin-top:8px;font-size:16px}.list-head h2{font-size:16px;margin:0}#message{white-space:pre-wrap;font-size:12px;line-height:1.8}
.invoice-menu{position:relative;display:inline-flex;margin-inline-end:6px;vertical-align:middle}
.invoice-menu-trigger{width:36px;height:36px;padding:0!important;border:1px solid #d9e5f2!important;border-radius:11px!important;background:#fff!important;color:#385875!important;font-size:22px!important;line-height:1;box-shadow:0 2px 7px #173a5c0a}
.invoice-menu-trigger:hover,.invoice-menu:focus-within .invoice-menu-trigger{background:#edf5ff!important;border-color:#9fc5ed!important;color:#1769b0!important}
.invoice-menu-pop{display:none;position:absolute;z-index:20;top:calc(100% + 4px);right:0;min-width:180px;padding:6px;background:#fff;border:1px solid #e0e9f3;border-radius:12px;box-shadow:0 12px 30px #183b5b24}
.invoice-menu:hover .invoice-menu-pop,.invoice-menu:focus-within .invoice-menu-pop{display:block}
.invoice-menu-pop button{display:flex;width:100%;align-items:center;gap:9px;text-align:right;padding:10px 12px!important;border-radius:8px!important;background:transparent!important;color:#294762!important;white-space:nowrap}
.invoice-menu-pop button:hover{background:#edf5ff!important;color:#1769b0!important}
.invoice-menu-pop .menu-icon{width:22px;text-align:center;font-size:16px;color:#2677c9}
@media(max-width:750px){.invoice-menu-pop{right:auto;left:0}.form-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.panel{padding:13px}.hero{padding:20px}.totals{gap:6px}.totals div{padding:9px}}{.form-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.panel{padding:13px}.hero{padding:20px}.totals{gap:6px}.totals div{padding:9px}}
</style>
<script>
(() => {
 const $=id=>document.getElementById(id), money=n=>Number(n||0).toLocaleString('fa-IR',{maximumFractionDigits:2}); let accounts=[],editingInvoiceId=null;
 const requestedKind=new URLSearchParams(window.location.search).get('kind');
 if(requestedKind==='Sales'||requestedKind==='Purchase') { $('kind').value=requestedKind; $('kind').disabled=true; }
 $('kind').addEventListener('change',()=>{ $('kind').disabled=false; });
 const today=new Date(); $('invoiceDate').value=new Date(today.getTime()-today.getTimezoneOffset()*60000).toISOString().slice(0,10);
 function addLine(line={description:'',quantity:1,unitPrice:0,discount:0,taxRate:0}) {
   const tr=document.createElement('tr');
   const fields=[['description','text',line.description,200],['quantity','number',line.quantity,''],['unitPrice','number',line.unitPrice,''],['discount','number',line.discount||0,''],['taxRate','number',line.taxRate,'']];
   for(const [key,type,value,max] of fields){const td=document.createElement('td'),input=document.createElement('input');input.dataset.field=key;input.type=type;input.value=value;input.required=key==='description';if(type==='number'){input.min='0';input.step=key==='quantity'?'0.001':'0.01';}if(max)input.maxLength=max;input.addEventListener('input',calculate);td.append(input);tr.append(td);}
   const amount=document.createElement('td');amount.className='line-total';amount.textContent='۰';tr.append(amount);
   const action=document.createElement('td'),remove=document.createElement('button');remove.type='button';remove.className='secondary';remove.textContent='حذف';remove.addEventListener('click',()=>{tr.remove();calculate();});action.append(remove);tr.append(action);$('lines').append(tr);calculate();
 }
 function calculate(){let subtotal=0,tax=0;for(const tr of $('lines').rows){const get=k=>tr.querySelector('[data-field="'+k+'"]').value;const gross=Math.max(0,Number(get('quantity'))||0)*Math.max(0,Number(get('unitPrice'))||0);const discount=Math.min(gross,Math.max(0,Number(get('discount'))||0));const base=gross-discount;const t=base*Math.max(0,Number(get('taxRate'))||0)/100;subtotal+=base;tax+=t;tr.querySelector('.line-total').textContent=money(base+t);} $('subtotal').textContent=money(subtotal)+' ریال';$('tax').textContent=money(tax)+' ریال';$('total').textContent=money(subtotal+tax)+' ریال';}
 async function loadParties(){const r=await fetch('/api/accounting/parties'),data=await r.json();if(!r.ok)throw Error(data.message||'بارگذاری اشخاص ناموفق بود');$('party').replaceChildren(new Option('انتخاب طرف حساب',''));for(const p of data.filter(x=>x.isActive))$('party').add(new Option(p.name,p.id));}
 async function loadAccounts(){const r=await fetch('/api/accounting/accounts'),data=await r.json();if(!r.ok)throw Error(data.message||'بارگذاری حساب‌ها ناموفق بود');accounts=data.filter(x=>x.isActive);}
 function accountSelect(type,placeholder){const select=document.createElement('select');select.required=true;select.append(new Option(placeholder,''));for(const a of accounts.filter(x=>x.type===type).sort((a,b)=>a.code.localeCompare(b.code)))select.append(new Option(a.code+' - '+a.title,a.id));select.setAttribute('aria-label',placeholder);select.style.maxWidth='230px';select.style.margin='3px';return select;}
 async function loadInvoices(){const r=await fetch('/api/accounting/invoices'),data=await r.json();if(!r.ok)throw Error(data.message||'بارگذاری فاکتورها ناموفق بود');const selectedKind=$('kind').value;const filteredData=data.filter(x=>x.kind===selectedKind);const body=$('invoiceRows');body.replaceChildren();for(const x of filteredData){const tr=document.createElement('tr');for(const v of [x.number,x.kind==='Sales'?'فروش':'خرید',new Date(x.invoiceDate).toLocaleDateString('fa-IR'),x.partyName,money(x.total)+' ریال',money(x.amountPaid)+' ریال',money(x.remaining)+' ریال',x.status==='Posted'?'ثبت نهایی':'پیش‌نویس']){const td=document.createElement('td');td.textContent=v;tr.append(td);}const td=document.createElement('td');const menu=document.createElement('div');menu.className='invoice-menu';const menuTrigger=document.createElement('button');menuTrigger.type='button';menuTrigger.className='invoice-menu-trigger';menuTrigger.textContent='⋮';menuTrigger.title='عملیات فاکتور';menuTrigger.setAttribute('aria-label','عملیات فاکتور '+x.number);menuTrigger.setAttribute('aria-haspopup','true');const menuPop=document.createElement('div');menuPop.className='invoice-menu-pop';const printAction=document.createElement('button');printAction.type='button';printAction.innerHTML='<span class="menu-icon">▤</span><span>چاپ فاکتور مشتری</span>';printAction.addEventListener('click',()=>printInvoice(x.id,x));menuPop.append(printAction);menu.append(menuTrigger,menuPop);td.append(menu);if(x.status==='Draft'){const edit=document.createElement('button');edit.className='secondary';edit.textContent='ویرایش';edit.addEventListener('click',()=>editInvoice(x.id));const del=document.createElement('button');del.className='secondary';del.textContent='حذف پیش‌نویس';del.addEventListener('click',()=>deleteInvoice(x.id,x.number));td.append(edit,del);const counterparty=accountSelect(x.kind==='Sales'?'Asset':'Liability',x.kind==='Sales'?'حساب دریافتنی':'حساب پرداختنی');const operating=accountSelect(x.kind==='Sales'?'Revenue':'Expense',x.kind==='Sales'?'حساب درآمد':'حساب هزینه');const tax=accountSelect(x.kind==='Sales'?'Liability':'Asset','حساب مالیات (در صورت نیاز)');tax.required=Number(x.taxTotal)>0;if(Number(x.taxTotal)===0)tax.append(new Option('بدون مالیات',''));const b=document.createElement('button');b.textContent='ثبت نهایی و صدور سند';b.addEventListener('click',()=>postInvoice(x.id,x.kind,counterparty,operating,tax));td.append(counterparty,operating);if(Number(x.taxTotal)>0)td.append(tax);td.append(b);}tr.append(td);body.append(tr);}if(!filteredData.length){const tr=document.createElement('tr'),td=document.createElement('td');td.colSpan=9;td.textContent=data.length?'برای این نوع فاکتور موردی ثبت نشده است.':'هنوز فاکتوری ثبت نشده است.';tr.append(td);body.append(tr);}}
 async function printInvoice(id,summary){try{const r=await fetch('/api/accounting/invoices/'+id),d=await r.json();if(!r.ok)throw Error(d.message||'دریافت جزئیات فاکتور برای چاپ ناموفق بود');const esc=v=>String(v??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));const kind=d.kind||summary.kind;const lines=Array.isArray(d.lines)?d.lines:[];let subtotal=0,taxTotal=0,discountTotal=0;const rows=lines.map((line,index)=>{const qty=Number(line.quantity)||0,price=Number(line.unitPrice)||0,gross=qty*price,discount=Math.min(gross,Math.max(0,Number(line.discount)||0)),base=gross-discount,tax=base*Math.max(0,Number(line.taxRate)||0)/100,total=base+tax;subtotal+=base;taxTotal+=tax;discountTotal+=discount;return '<tr><td class="num">'+(index+1).toLocaleString('fa-IR')+'</td><td>'+esc(line.description)+'</td><td class="num">'+qty.toLocaleString('fa-IR')+'</td><td class="num">'+price.toLocaleString('fa-IR')+'</td><td class="num">'+discount.toLocaleString('fa-IR')+'</td><td class="num">'+(Number(line.taxRate)||0).toLocaleString('fa-IR')+'٪</td><td class="num strong">'+total.toLocaleString('fa-IR',{maximumFractionDigits:2})+'</td></tr>';}).join('');const total=Number(d.total??summary.total??subtotal+taxTotal)||0;const invoiceDate=new Date(d.invoiceDate||summary.invoiceDate);const dateText=Number.isNaN(invoiceDate.getTime())?'—':invoiceDate.toLocaleDateString('fa-IR');const paid=Number(d.amountPaid??summary.amountPaid)||0;const remaining=Number(d.remaining??summary.remaining??(total-paid))||0;const party=d.partyName||summary.partyName||$('party').selectedOptions[0]?.textContent||'—';const title=kind==='Purchase'?'فاکتور خرید':'فاکتور فروش';const win=window.open('','_blank','width=1000,height=850');if(!win){alert('برای چاپ فاکتور، اجازه بازشدن پنجره جدید (Pop-up) را در مرورگر فعال کنید.');return;}const html='<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>'+esc(title+' '+(d.number||summary.number))+'</title><style>*{box-sizing:border-box}body{margin:0;background:#f0f4f8;color:#24364b;font:12px/1.9 Tahoma,Arial,sans-serif}.sheet{max-width:920px;margin:28px auto;padding:34px;background:white;border:1px solid #e1e8f0;border-radius:18px;box-shadow:0 10px 36px #183b5b12}.top{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;border-bottom:3px solid #2476bd;padding-bottom:22px}.brand{display:flex;gap:13px;align-items:center}.mark{width:54px;height:54px;border-radius:16px;display:grid;place-items:center;background:linear-gradient(135deg,#155a96,#42a5e8);color:#fff;font-size:27px;font-weight:bold}.brand h1{font-size:20px;margin:0;color:#174b7e}.brand p{margin:4px 0 0;color:#71849a}.invoice-title{text-align:left}.invoice-title .kind{display:inline-block;background:#eaf4ff;color:#1769ad;border:1px solid #d1e7fb;border-radius:30px;padding:4px 13px;font-size:11px}.invoice-title h2{font-size:22px;margin:8px 0 0;color:#1b4267}.meta{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:22px 0}.meta div{padding:12px 14px;border:1px solid #e4ebf3;background:#f8fbff;border-radius:11px}.label{display:block;font-size:10px;color:#8292a5;margin-bottom:4px}.value{font-weight:bold;font-size:13px;overflow-wrap:anywhere}.party{border:1px solid #e2eaf3;border-radius:12px;padding:15px 17px;margin:18px 0}.party h3{margin:0 0 7px;color:#53718e;font-size:11px}.party strong{font-size:15px}.notes{margin-top:8px;color:#667a90}.items{width:100%;border-collapse:collapse;margin-top:20px}.items th{background:#174b7e;color:#fff;font-weight:normal}.items th,.items td{padding:10px 8px;border:1px solid #e0e8f0;text-align:right}.items tbody tr:nth-child(even){background:#f7faff}.num{font-variant-numeric:tabular-nums;white-space:nowrap}.strong{font-weight:bold;color:#174b7e}.bottom{display:grid;grid-template-columns:1fr 300px;gap:22px;margin-top:22px}.message{border:1px dashed #cbd9e8;border-radius:12px;padding:14px;color:#71849a;align-self:start}.totals{border:1px solid #e1e9f2;border-radius:13px;overflow:hidden}.total-row{display:flex;justify-content:space-between;gap:14px;padding:9px 13px;border-bottom:1px solid #edf1f6}.total-row:last-child{border-bottom:0}.grand{background:#eaf4ff;color:#174b7e;font-size:15px;font-weight:bold;padding:14px}.balance{background:#f8fbff;font-weight:bold}.foot{display:flex;justify-content:space-between;gap:16px;margin-top:34px;padding-top:14px;border-top:1px solid #e5ebf2;color:#8594a6;font-size:10px}.sign{margin-top:36px;display:flex;justify-content:space-between;gap:40px;text-align:center;color:#71849a}.sign div{width:42%;padding-top:10px;border-top:1px dashed #c9d6e4}@page{size:A4;margin:12mm}@media print{body{background:#fff}.sheet{max-width:none;margin:0;padding:0;border:0;border-radius:0;box-shadow:none}.no-print{display:none!important;print-color-adjust:exact;-webkit-print-color-adjust:exact}thead{display:table-header-group}tr{break-inside:avoid}.items{break-inside:auto}}</style></head><body><div class="sheet"><div class="top"><div class="brand"><div class="mark">ق</div><div><h1>ققنوس</h1><p>سامانه حسابداری و مدیریت مالی</p></div></div><div class="invoice-title"><span class="kind">'+esc(kind==='Purchase'?'فاکتور خرید':'فاکتور فروش')+'</span><h2>'+esc(title)+'</h2></div></div><div class="meta"><div><span class="label">شماره فاکتور</span><span class="value">'+esc(d.number||summary.number||'—')+'</span></div><div><span class="label">تاریخ صدور</span><span class="value">'+esc(dateText)+'</span></div><div><span class="label">وضعیت</span><span class="value">'+esc((d.status||summary.status)==='Posted'?'ثبت نهایی':'پیش‌نویس')+'</span></div></div><div class="party"><h3>'+(kind==='Purchase'?'تأمین‌کننده':'صورتحساب مشتری')+'</h3><strong>'+esc(party)+'</strong>'+(d.notes?'<div class="notes">توضیحات: '+esc(d.notes)+'</div>':'')+'</div><table class="items"><thead><tr><th>ردیف</th><th>شرح کالا یا خدمت</th><th>تعداد</th><th>قیمت واحد (ریال)</th><th>تخفیف (ریال)</th><th>مالیات</th><th>مبلغ (ریال)</th></tr></thead><tbody>'+rows+'</tbody></table><div class="bottom"><div class="message">از اعتماد شما سپاسگزاریم.<br>لطفاً اطلاعات فاکتور را بررسی فرمایید و در صورت وجود مغایرت با صادرکننده هماهنگ کنید.</div><div class="totals"><div class="total-row"><span>جمع پس از تخفیف (ریال)</span><strong>'+subtotal.toLocaleString('fa-IR',{maximumFractionDigits:2})+'</strong></div><div class="total-row"><span>مجموع تخفیف (ریال)</span><strong>'+discountTotal.toLocaleString('fa-IR',{maximumFractionDigits:2})+'</strong></div><div class="total-row"><span>مالیات و عوارض (ریال)</span><strong>'+taxTotal.toLocaleString('fa-IR',{maximumFractionDigits:2})+'</strong></div><div class="total-row grand"><span>مبلغ نهایی (ریال)</span><strong>'+total.toLocaleString('fa-IR',{maximumFractionDigits:2})+'</strong></div><div class="total-row"><span>پرداخت‌شده (ریال)</span><strong>'+paid.toLocaleString('fa-IR',{maximumFractionDigits:2})+'</strong></div><div class="total-row balance"><span>مانده حساب (ریال)</span><strong>'+remaining.toLocaleString('fa-IR',{maximumFractionDigits:2})+'</strong></div></div></div><div class="sign"><div>مهر و امضای صادرکننده</div><div>امضا / تأیید مشتری</div></div><div class="foot"><span>این فاکتور توسط سامانه حسابداری ققنوس تهیه شده است.</span><span>شماره: '+esc(d.number||summary.number||'—')+'</span></div><div class="no-print" style="text-align:center;margin-top:24px"><button onclick="window.print()" style="border:0;border-radius:9px;background:#2476bd;color:white;padding:12px 24px;font:inherit;cursor:pointer">چاپ فاکتور / ذخیره PDF</button></div></div></body></html>';win.document.open();win.document.write(html);win.document.close();setTimeout(()=>{if(!win.closed){win.focus();win.print();}},500);}catch(e){$('message').textContent=e.message||'آماده‌سازی چاپ فاکتور ناموفق بود.';}}
 function resetForm(){editingInvoiceId=null;$('kind').disabled=false;$('number').value='';$('notes').value='';$('lines').replaceChildren();addLine();$('saveDraft').textContent='ذخیره پیش‌نویس';const cancel=$('cancelEdit');if(cancel)cancel.remove();}
 async function editInvoice(id){try{const r=await fetch('/api/accounting/invoices/'+id),d=await r.json();if(!r.ok)throw Error(d.message||'دریافت فاکتور ناموفق بود');editingInvoiceId=id;$('kind').value=d.kind;$('kind').disabled=true;$('number').value=d.number;$('invoiceDate').value=new Date(d.invoiceDate).toISOString().slice(0,10);$('party').value=String(d.partyId);$('notes').value=d.notes||'';$('lines').replaceChildren();for(const line of d.lines)addLine(line);$('saveDraft').textContent='ذخیره تغییرات';if(!$('cancelEdit')){const b=document.createElement('button');b.id='cancelEdit';b.type='button';b.className='secondary';b.textContent='لغو ویرایش';b.addEventListener('click',resetForm);$('saveDraft').after(b);}window.scrollTo({top:0,behavior:'smooth'});$('message').textContent='در حال ویرایش پیش‌نویس شماره '+d.number;}catch(e){$('message').textContent=e.message;}}
 async function deleteInvoice(id,number){if(!confirm('پیش‌نویس فاکتور '+number+' حذف شود؟ این کار قابل بازگشت نیست.'))return;try{const r=await fetch('/api/accounting/invoices/'+id,{method:'DELETE'}),d=await r.json();if(!r.ok)throw Error(d.message||'حذف فاکتور ناموفق بود');$('message').textContent=d.message||'پیش‌نویس حذف شد.';if(editingInvoiceId===id)resetForm();await loadInvoices();}catch(e){$('message').textContent=e.message;}}
 async function postInvoice(id,kind,counterparty,operating,tax){if(!counterparty.value||!operating.value||(tax.required&&!tax.value)){ $('message').textContent='حساب دریافتنی/پرداختنی، درآمد/هزینه و در صورت وجود مالیات را انتخاب کنید.';return;}if(!confirm('فاکتور ثبت نهایی شود و سند حسابداری مرتبط ایجاد شود؟'))return;try{const payload={counterpartyAccountId:Number(counterparty.value),operatingAccountId:Number(operating.value),taxAccountId:tax.value?Number(tax.value):null};const r=await fetch('/api/accounting/invoices/'+id+'/post',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}),d=await r.json();if(!r.ok)throw Error(d.message||'ثبت نهایی ناموفق بود');$('message').textContent=d.message||'فاکتور و سند حسابداری ثبت شدند.';await loadInvoices();const settle=confirm((kind==='Purchase'?'فاکتور خرید':'فاکتور فروش')+' با موفقیت ثبت نهایی شد. آیا مایل به '+(kind==='Purchase'?'پرداخت وجه این فاکتور':'دریافت وجه این فاکتور')+' هستید؟');if(settle){const paymentKind=kind==='Purchase'?'Payment':'Receipt';window.location.assign('/Accounting/Payments?kind='+paymentKind+'&invoiceId='+encodeURIComponent(id));}}catch(e){$('message').textContent=e.message;}}
 $('addLine').addEventListener('click',()=>addLine());$('kind').addEventListener('change',()=>loadInvoices().catch(e=>$('message').textContent=e.message));$('refresh').addEventListener('click',()=>loadInvoices().catch(e=>$('message').textContent=e.message));
 $('saveDraft').addEventListener('click',async()=>{try{const lines=[...$('lines').rows].map(tr=>Object.fromEntries([...tr.querySelectorAll('[data-field]')].map(i=>[i.dataset.field,i.type==='number'?Number(i.value):i.value.trim()])));if(!lines.length||lines.some(x=>!x.description||x.quantity<=0||x.unitPrice<0||x.discount<0||x.taxRate<0))throw Error('حداقل یک ردیف معتبر وارد کنید؛ تعداد باید مثبت باشد.');const payload={kind:$('kind').value,number:$('number').value.trim(),invoiceDate:$('invoiceDate').value,partyId:Number($('party').value),notes:$('notes').value.trim(),lines};const url=editingInvoiceId?'/api/accounting/invoices/'+editingInvoiceId:'/api/accounting/invoices';const r=await fetch(url,{method:editingInvoiceId?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}),d=await r.json();if(!r.ok)throw Error(d.message||'ذخیره فاکتور ناموفق بود');$('message').textContent=d.message||(editingInvoiceId?'پیش‌نویس فاکتور ویرایش شد.':'پیش‌نویس فاکتور ذخیره شد.');resetForm();await loadInvoices();}catch(e){$('message').textContent=e.message;}});
 addLine();Promise.all([loadParties(),loadAccounts()]).then(loadInvoices).catch(e=>$('message').textContent=e.message);
})();
</script>
