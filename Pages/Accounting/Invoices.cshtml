@page
@{
    ViewData["Title"] = "فروش و خرید";
}
<div class="business-page" dir="rtl">
    <section class="hero"><div><span class="eyebrow">عملیات بازرگانی</span><h1>فاکتورهای فروش و خرید</h1><p>ثبت فاکتور، محاسبه ردیف‌ها و مالیات، و ایجاد سند حسابداری از فاکتور تأییدشده.</p></div></section>
    <section class="panel">
        <div class="form-grid">
            <label>نوع فاکتور<select id="kind"><option value="Sales">فروش</option><option value="Purchase">خرید</option></select></label>
            <label>شماره فاکتور<input id="number" maxlength="40" required placeholder="مثلاً S-1001"></label>
            <label>تاریخ<input id="invoiceDate" type="date" required></label>
            <label>مشتری / تأمین‌کننده<select id="party" required><option value="">در حال بارگذاری...</option></select></label>
        </div>
        <label class="notes-label">توضیحات<input id="notes" maxlength="500" placeholder="توضیحات اختیاری"></label>
        <div class="table-scroll"><table><thead><tr><th>شرح کالا یا خدمت</th><th>تعداد</th><th>قیمت واحد (ریال)</th><th>تخفیف (ریال)</th><th>مالیات ٪</th><th>مبلغ کل</th><th></th></tr></thead><tbody id="lines"></tbody></table></div>
        <div class="actions"><button type="button" id="addLine" class="secondary">افزودن ردیف</button><button type="button" id="saveDraft">ذخیره پیش‌نویس</button></div>
        <div class="totals"><div><span>جمع جزء</span><strong id="subtotal">۰</strong></div><div><span>مالیات</span><strong id="tax">۰</strong></div><div><span>مبلغ نهایی</span><strong id="total">۰</strong></div></div>
        <p id="message" role="status" aria-live="polite"></p>
    </section>
    <section class="panel"><div class="list-head"><h2>فاکتورهای ثبت‌شده</h2><button type="button" class="secondary" id="refresh">بازخوانی</button></div><div class="table-scroll"><table><thead><tr><th>شماره</th><th>نوع</th><th>تاریخ</th><th>طرف حساب</th><th>مبلغ فاکتور</th><th>دریافتی / پرداختی</th><th>مانده</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody id="invoiceRows"><tr><td colspan="9">در حال دریافت...</td></tr></tbody></table></div></section>
</div>
<style>
.business-page{max-width:1400px;margin:auto;color:#20334b;font-family:Tahoma,Arial,sans-serif}.hero{padding:24px 28px;margin-bottom:18px;border:1px solid #dbe9f8;border-radius:17px;background:linear-gradient(110deg,#fff,#eaf4ff)}.eyebrow{font-size:11px;color:#2677c9;font-weight:700}.hero h1{font-size:25px;margin:9px 0}.hero p{margin:0;color:#74859a;font-size:12px;line-height:1.9}.panel{padding:20px;margin-bottom:18px;background:#fff;border:1px solid #e2eaf4;border-radius:15px}.form-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.form-grid label,.notes-label{display:flex;flex-direction:column;gap:7px;font-size:12px;color:#52667e;font-weight:700}.business-page input,.business-page select{min-width:0;padding:10px;border:1px solid #d9e3ef;border-radius:8px;background:#fff;font:inherit;font-size:12px}.notes-label{margin-top:14px}.table-scroll{overflow:auto;margin-top:16px}table{width:100%;border-collapse:collapse;min-width:780px}th,td{padding:11px 9px;text-align:right;border-bottom:1px solid #edf1f6;font-size:12px}th{background:#f7faff;color:#64768b}td input{width:100%;box-sizing:border-box}.actions,.list-head{display:flex;align-items:center;gap:10px;justify-content:space-between;margin-top:14px}.business-page button{border:0;border-radius:8px;padding:10px 15px;background:#2677c9;color:white;font:inherit;font-size:12px;cursor:pointer}.business-page button.secondary{background:#edf5ff;color:#2465a5}.totals{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:18px}.totals div{padding:13px;border:1px solid #e5edf6;border-radius:10px;background:#f8fbff}.totals span,.totals strong{display:block}.totals span{font-size:11px;color:#8292a6}.totals strong{margin-top:8px;font-size:16px}.list-head h2{font-size:16px;margin:0}#message{white-space:pre-wrap;font-size:12px;line-height:1.8}
.invoice-menu{position:relative;display:inline-flex;margin-inline-end:6px;vertical-align:middle}
.invoice-menu-trigger{width:36px;height:36px;padding:0!important;border:1px solid #d9e5f2!important;border-radius:11px!important;background:#fff!important;color:#385875!important;font-size:22px!important;line-height:1;box-shadow:0 2px 7px #173a5c0a}
.invoice-menu-trigger:hover,.invoice-menu:focus-within .invoice-menu-trigger{background:#edf5ff!important;border-color:#9fc5ed!important;color:#1769b0!important}
.invoice-menu-pop{display:none;position:absolute;z-index:20;top:calc(100% + 4px);right:0;min-width:180px;padding:6px;background:#fff;border:1px solid #e0e9f3;border-radius:12px;box-shadow:0 12px 30px #183b5b24}
.invoice-menu:hover .invoice-menu-pop,.invoice-menu:focus-within .invoice-menu-pop{display:block}
.invoice-menu-pop button{display:flex;width:100%;align-items:center;gap:9px;text-align:right;padding:10px 12px!important;border-radius:8px!important;background:transparent!important;color:#294762!important;white-space:nowrap}
.invoice-menu-pop button:hover{background:#edf5ff!important;color:#1769b0!important}
.invoice-menu-pop .menu-icon{width:22px;text-align:center;font-size:16px;color:#2677c9}
@@media(max-width:750px){.invoice-menu-pop{right:auto;left:0}.form-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.panel{padding:13px}.hero{padding:20px}.totals{gap:6px}.totals div{padding:9px}}
</style>
<script src="/js/accounting-invoices.js?v=20261128" defer></script>
