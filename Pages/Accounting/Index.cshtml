@page
@model GhoghnoosAcc.Pages.Accounting.IndexModel
@{
    ViewData["Title"] = "ثبت سند حسابداری";
}
<div dir="rtl" class="accounting-entry">
    <h1>ثبت سند حسابداری</h1>
    <p class="intro">تاریخ و شرح سند را وارد کنید. نام یا کد هر حساب باید قبلاً در صفحه <a href="/Accounting/Accounts">مدیریت حساب‌ها</a> ثبت شده باشد. فقط اسناد متوازن در PostgreSQL ذخیره می‌شوند.</p>
    <div class="toolbar">
        <label>تاریخ سند <input id="entryDate" type="date" required /></label>
        <label class="description">شرح سند <input id="description" type="text" maxlength="500" placeholder="شرح کوتاه سند" /></label>
    </div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>کد یا عنوان حساب</th><th>بدهکار</th><th>بستانکار</th><th></th></tr></thead>
            <tbody id="lines">
                <tr><td><input aria-label="حساب ردیف اول" class="account" value="صندوق" /></td><td><input class="debit" type="number" min="0" step="0.01" value="100000" /></td><td><input class="credit" type="number" min="0" step="0.01" value="0" /></td><td><button type="button" class="remove" aria-label="حذف ردیف">حذف</button></td></tr>
                <tr><td><input aria-label="حساب ردیف دوم" class="account" value="سرمایه" /></td><td><input class="debit" type="number" min="0" step="0.01" value="0" /></td><td><input class="credit" type="number" min="0" step="0.01" value="100000" /></td><td><button type="button" class="remove" aria-label="حذف ردیف">حذف</button></td></tr>
            </tbody>
        </table>
    </div>
    <div class="actions">
        <button type="button" id="addLine" class="secondary">افزودن ردیف</button>
        <button type="button" id="validate">بررسی تراز</button>
        <button type="button" id="save">ذخیره سند در PostgreSQL</button>
    </div>
    <section id="result" class="result" aria-live="polite" hidden></section>
</div>
<style>
.accounting-entry{max-width:1000px;margin:24px auto;padding:24px;color:#1f2937;font-family:Tahoma,Arial,sans-serif}
.accounting-entry h1{font-size:1.7rem;margin-bottom:10px}.intro{color:#596579;line-height:1.9}
.toolbar,.actions{display:flex;gap:12px;align-items:end;flex-wrap:wrap;margin:20px 0}
.toolbar label{display:flex;flex-direction:column;gap:8px;font-weight:600}.toolbar input{min-width:180px}
.toolbar .description{flex:1}.toolbar .description input{width:100%;box-sizing:border-box}
.accounting-entry input{padding:10px;border:1px solid #cbd5e1;border-radius:8px;font:inherit;box-sizing:border-box;width:100%;min-width:90px}
.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;min-width:540px}th,td{padding:9px;border-bottom:1px solid #e2e8f0;text-align:right}th{background:#f1f5f9}
.accounting-entry button{border:0;border-radius:8px;padding:11px 17px;background:#1d4ed8;color:white;font:inherit;cursor:pointer}
.accounting-entry button.secondary{background:#475569}.accounting-entry button.remove{background:#e2e8f0;color:#334155;padding:8px}
.result{margin-top:18px;padding:16px;border:1px solid #cbd5e1;border-radius:10px;line-height:2;white-space:pre-line}
.result.good{border-color:#16a34a;background:#f0fdf4}.result.bad{border-color:#dc2626;background:#fef2f2}
</style>
<script>
(() => {
    const body = document.getElementById('lines');
    const result = document.getElementById('result');
    const today = new Date();
    document.getElementById('entryDate').value = `${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,'0')}-${String(today.getDate()).padStart(2,'0')}`;

    function addRow(account = '', debit = '0', credit = '0') {
        const tr = document.createElement('tr');
        tr.innerHTML = '<td><input aria-label="کد یا عنوان حساب" class="account" maxlength="200"></td><td><input class="debit" type="number" min="0" step="0.01"></td><td><input class="credit" type="number" min="0" step="0.01"></td><td><button type="button" class="remove" aria-label="حذف ردیف">حذف</button></td>';
        tr.querySelector('.account').value = account;
        tr.querySelector('.debit').value = debit;
        tr.querySelector('.credit').value = credit;
        body.appendChild(tr);
    }
    document.getElementById('addLine').addEventListener('click', () => addRow());
    body.addEventListener('click', e => {
        if (e.target.classList.contains('remove')) {
            if (body.rows.length > 2) e.target.closest('tr').remove();
            else show('سند باید حداقل دو ردیف داشته باشد.', false);
        }
    });
    function show(message, good, data) {
        result.hidden = false;
        result.className = 'result ' + (good ? 'good' : 'bad');
        const totals = data && data.debitTotal !== undefined
            ? `\nجمع بدهکار: ${Number(data.debitTotal).toLocaleString('fa-IR')}\nجمع بستانکار: ${Number(data.creditTotal).toLocaleString('fa-IR')}\nاختلاف: ${Number(data.difference ?? (data.debitTotal-data.creditTotal)).toLocaleString('fa-IR')}`
            : '';
        const missing = data && data.missingAccounts ? `\nحساب‌های تعریف‌نشده: ${data.missingAccounts.join('، ')}` : '';
        result.textContent = message + totals + missing;
    }
    async function submit(endpoint) {
        const entryDate = document.getElementById('entryDate').value;
        if (!entryDate) { show('تاریخ سند را وارد کنید.', false); return; }
        const lines = [...body.querySelectorAll('tr')].map(tr => ({
            accountName: tr.querySelector('.account').value.trim(),
            debit: Number(tr.querySelector('.debit').value || 0),
            credit: Number(tr.querySelector('.credit').value || 0)
        }));
        try {
            const response = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ entryDate: `${entryDate}T00:00:00`, description: document.getElementById('description').value, lines })
            });
            const data = await response.json();
            const message = endpoint.endsWith('entries') && response.ok
                ? `سند با موفقیت ذخیره شد. شماره سند: ${data.documentNumber}`
                : (data.message || data.detail || 'پاسخ نامعتبر از سرور دریافت شد.');
            show(message, response.ok && (endpoint.endsWith('entries') || data.isValid), data);
        } catch {
            show('ارتباط با سرور برقرار نشد. ابتدا برنامه و پایگاه داده را بررسی کنید.', false);
        }
    }
    document.getElementById('validate').addEventListener('click', () => submit('/api/accounting/validate-entry'));
    document.getElementById('save').addEventListener('click', () => submit('/api/accounting/entries'));
})();
</script>
