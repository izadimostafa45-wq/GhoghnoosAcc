<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GhoghnoosAcc</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GhoghnoosAcc.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar" aria-label="منوی اصلی">
            <a class="brand" asp-area="" asp-page="/Index">
                <span class="brand-mark" aria-hidden="true">ق</span>
                <span class="brand-copy"><strong>ققنوس</strong><small>سیستم حسابداری</small></span>
            </a>
            <div class="sidebar-caption">منوی اصلی</div>
            <nav class="side-nav">
                <a class="side-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")" asp-area="" asp-page="/Index">
                    <span class="nav-icon">▦</span><span>داشبورد</span>
                </a>
                <details class="nav-group" open>
                    <summary class="side-link"><span class="nav-icon">▤</span><span>تعاریف</span><span class="nav-chevron">⌄</span></summary>
                    <div class="sub-nav">
                        <a class="side-link sub-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Accounting/Accounts" ? "active" : "")" asp-area="" asp-page="/Accounting/Accounts">مدیریت حساب‌ها</a>
                        <a class="side-link sub-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Accounting/Parties" ? "active" : "")" asp-area="" asp-page="/Accounting/Parties">مدیریت اشخاص</a>
                    </div>
                </details>
                <a class="side-link" asp-area="" asp-page="/Accounting/Index">
                    <span class="nav-icon">▧</span><span>ثبت سند حسابداری</span>
                </a>
            </nav>
            <div class="sidebar-bottom">
                <span class="status-dot"></span><span>محیط محلی حسابداری</span>
            </div>
        </aside>
        <div class="app-main">
            <header class="topbar">
                <div>
                    <span class="topbar-eyebrow">سامانه مالی ققنوس</span>
                    <strong>@ViewData["Title"]</strong>
                </div>
                <div class="d-flex align-items-center gap-3"><div class="topbar-badge"><span class="status-dot"></span> فضای کاری</div>@if (User.Identity?.IsAuthenticated == true) { <a class="btn btn-sm btn-outline-secondary" asp-page="/Account/Logout">خروج</a> }</div>
            </header>
            <main role="main" class="page-content">
                @RenderBody()
            </main>
            <footer class="app-footer">© 2026 ققنوس · سیستم حسابداری</footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
